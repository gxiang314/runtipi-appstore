{
  "services": [
    {
      "name": "honkit",
      "image": "honkit/honkit:v6.1.7",
      "isMain": true,
      "internalPort": 4000,
      "workingDir": "/book",
      "entrypoint": ["/bin/sh", "-c", "[ -f /book/SUMMARY.md ] || honkit init /book; exec honkit serve /book /book/_book --port 4000 --lrport 35729"],
      "environment": [
        {
          "key": "TZ",
          "value": "${TZ}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/book",
          "containerPath": "/book"
        }
      ]
    }
  ],
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json"
}
